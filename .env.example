# ===============================================================
# Citi MLOps Plane — environment variables.
# Copy to .env (or export in your shell) before starting the backend.
# Every URL/secret in the plane is configured here — nothing is
# hard-coded in code.
# ===============================================================

# ---------- PostgreSQL ----------
# Default matches docker-compose.yml (`docker compose up -d`).
MLOPS_POSTGRES_DSN=postgresql+asyncpg://mlops:mlops@localhost:5432/mlops
MLOPS_DB_ECHO=0

# ---------- GSSP-GS (LLM gateway) ----------
# Leave GSSP_USE_DUMMY=1 for local dev. Flip to 0 + set GSSP_BASE_URL
# + GSSP_AUTH_TOKEN when going against the real Citi gateway.
GSSP_USE_DUMMY=1
GSSP_BASE_URL=
GSSP_PASS_THROUGH_PATH=/api/gssp-generation-service/v1/generate-pass-through
GSSP_AUTH_TOKEN=
GSSP_APPLICATION_ID=citi-mlops-plane
GSSP_SOEID=
GSSP_DEFAULT_MODEL=gpt-4o-mini
GSSP_TIMEOUT_SECONDS=120

# ---------- Stellar (datasets + fine-tune) ----------
STELLAR_USE_DUMMY=1
STELLAR_BASE_URL=
STELLAR_REGISTER_DATASET_PATH=/api/v1/datasets/register
STELLAR_SUBMIT_FINETUNE_PATH=/api/v1/finetune/submit
STELLAR_GET_STATUS_PATH=/api/v1/finetune/{job_id}/status
STELLAR_AUTH_TOKEN=
STELLAR_TIMEOUT_SECONDS=60

# ---------- S3 ----------
S3_USE_DUMMY=1
# When S3_USE_DUMMY=1, files are stored under this local directory.
MLOPS_LOCAL_S3_ROOT=/tmp/mlops-s3
# Real-mode credentials (ignored when S3_USE_DUMMY=1).
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MLOPS_S3_INPUT_BUCKET=citi-mlops-inputs
MLOPS_S3_OUTPUT_BUCKET=citi-mlops-outputs
